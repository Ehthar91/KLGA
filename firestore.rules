rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGoogleAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function hasAccessRecord() {
      return isGoogleAccount()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function accessData() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    // Existing teacher documents without a role field remain full teachers.
    // Set role: "viewer" for read-only results access.
    function isTeacher() {
      return hasAccessRecord()
        && (!("role" in accessData()) || accessData().role != 'viewer');
    }

    function isViewer() {
      return hasAccessRecord()
        && ("role" in accessData())
        && accessData().role == 'viewer';
    }

    function canReadResults() {
      return isTeacher() || isViewer();
    }

    function isAnonymousStudent() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // A student may reclaim a stale session record after moving to a different
    // Chromebook/browser only when the old attempt is not actively testing and
    // the student is actually assigned to the still-active session.
    function canReclaimStudentSession() {
      let session = get(/databases/$(database)/documents/sessions/$(resource.data.sessionKey));
      return isAnonymousStudent()
        && session.data.status == 'Active'
        && session.data.studentKeys.hasAny([resource.data.studentKey])
        && resource.data.status in ['waiting', 'paused', 'terminated']
        && request.resource.data.sessionKey == resource.data.sessionKey
        && request.resource.data.studentKey == resource.data.studentKey
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['authUid', 'status', 'updatedAt']);
    }

    // Access allowlist. The document ID is the Google user's Firebase UID.
    // Optional field: role = "viewer". No role field means full teacher access.
    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Roster remains teacher-only. Viewers cannot read or change it.
    match /students/{studentId} {
      allow read, write: if isTeacher();
    }

    // Sessions remain teacher-managed. Anonymous students can read active
    // sessions to join them. Viewers cannot read session documents.
    match /sessions/{sessionId} {
      allow read: if isTeacher()
        || (isAnonymousStudent() && resource.data.status == 'Active');
      allow create, update, delete: if isTeacher();
    }

    // Live student/session records remain teacher/student only.
    match /sessionStudents/{statusId} {
      allow read: if isTeacher()
        || (isAnonymousStudent() && resource.data.authUid == request.auth.uid);

      allow create: if isAnonymousStudent()
        && request.resource.data.authUid == request.auth.uid;

      allow update: if isTeacher()
        || (isAnonymousStudent()
            && resource.data.authUid == request.auth.uid
            && request.resource.data.authUid == resource.data.authUid)
        || canReclaimStudentSession();

      allow delete: if isTeacher();
    }

    // Viewers may read results, but only teachers may delete them.
    // Students can submit only their own result.
    match /results/{resultId} {
      allow read: if canReadResults();
      allow delete: if isTeacher();

      allow create: if isAnonymousStudent()
        && request.resource.data.authUid == request.auth.uid;

      allow update: if false;
    }
  }
}
