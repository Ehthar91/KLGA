
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // MVP DEVELOPMENT RULES ONLY.
    // Replace with authenticated teacher/student rules before production use.
    match /students/{docId} {
      allow read, write: if true;
    }

    match /sessions/{docId} {
      allow read, write: if true;
    }

    match /sessionStudents/{docId} {
      allow read, write: if true;
    }

    match /results/{docId} {
      allow read, write: if true;
    }
  }
}
